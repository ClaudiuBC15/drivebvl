---
/**
 * Logo — START DRIVE BVL
 * Renders the dynamic logo from settings, falling back to logo.png.
 */
import { getDB, queryAll } from '../lib/db';

interface Props {
  variant?: 'light' | 'dark'; // Kept for interface compatibility
  class?: string;
}

const { class: className = '' } = Astro.props;

const db = getDB(Astro.locals);
let dbSettings = {} as Record<string, string>;
try {
  const rows = await queryAll<any>(db, 'SELECT key, value FROM settings');
  rows.forEach(r => {
    dbSettings[r.key] = r.value;
  });
} catch (err) {
  console.error('Error fetching logo_url setting:', err);
}

const logoUrl = dbSettings.logo_url || '/images/logo.png';
---

<a href="/" class:list={['group inline-flex items-center', className]} aria-label="Start Drive BVL — pagina principală">
  <img 
    src={logoUrl} 
    alt="Start Drive BVL Logo" 
    class="h-10 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.02]" 
  />
</a>
